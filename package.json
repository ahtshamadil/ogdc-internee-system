{
  "name": "ogdc-internee-system",
  "version": "1.0.0",
  "private": true,
  "description": "OGDC Internee Management System - LAN-hosted intern records and analytics",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:demo": "npm run seed:demo --workspace server",
    "reset-password": "npm run reset-password --workspace server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
