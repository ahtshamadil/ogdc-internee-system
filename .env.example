# Copy this file to .env and adjust. The server reads it on startup.

# Port the app listens on. Everyone on the LAN opens http://<server-ip>:<PORT>
PORT=4000

# Where the SQLite database and uploaded documents live.
#
# IMPORTANT: this must NOT be inside OneDrive, Dropbox or any syncing folder.
# Sync clients lock files mid-write; pointed at a live SQLite database (and its
# -wal / -shm siblings) that reliably corrupts it.
DATA_DIR=C:\OGDC-Internee-Data

# Secret used to sign login cookies. Leave blank and the server generates a
# strong one into .env on first start. Changing it logs everyone out.
JWT_SECRET=

# Maximum size of a single uploaded document, in megabytes.
MAX_UPLOAD_MB=10

# Set to "production" on the OGDC machine so the server also serves the built
# frontend from client/dist on the same port.
NODE_ENV=development
